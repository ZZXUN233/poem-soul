# ============================================
# peom-soul (诗魂) 环境变量样例
# 复制为 .env 后按需修改。注意：本项目自包含、无数据库，
# .env 不是必需项；不创建也能正常构建部署。
# ============================================

# 公开访问地址（用于站内绝对链接 / 分享）
NEXT_PUBLIC_BASE_URL=https://ps.zzxun.cn

# 宿主映射端口（应避免与 3005/demos 等已用端口冲突；改这里需同步改 nginx/ps.conf 与 deploy.sh 的 HOST_PORT）
PEOM_PORT=3006
